{
  "name": "posturepal",
  "version": "1.4.2",
  "description": "Posture tracking app",
  "author": "Maan Teckwani <maanteckwani@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "concurrently \"npm run build:watch\" \"wait-on dist/bundle.js && electron .\"",
    "build": "webpack --mode production",
    "build:watch": "webpack --watch",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:all": "npm run build && electron-builder --mac --win --linux --publish never",
    "release": "npm run build && electron-builder --mac --win --linux --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "@tensorflow-models/pose-detection": "^2.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@vercel/analytics": "^2.0.1",
    "canvas": "^3.2.3",
    "dotenv-webpack": "^9.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-react": "^7.22.15",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "html-webpack-plugin": "^5.5.3",
    "wait-on": "^7.0.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  }
}
